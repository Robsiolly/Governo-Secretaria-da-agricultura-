rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções de validação de integridade e segurança
    function isValidStatus(status) {
      return status in ['EM_TRANSITO', 'FINALIZADO'];
    }

    function isValidSecretaria(sec) {
      return sec in ['Secretaria da Agricultura', 'Secretaria do Turismo'];
    }

    function isValidRegistro(data) {
      return data.keys().hasAll(['id', 'secretaria', 'motorista', 'status'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && isValidSecretaria(data.secretaria)
        && data.motorista is string && data.motorista.size() > 0 && data.motorista.size() <= 200
        && isValidStatus(data.status);
    }

    function isValidOperador(data) {
      return data.keys().hasAll(['id', 'nome', 'matricula', 'nivelAcesso'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 150
        && data.matricula is string && data.matricula.size() > 0 && data.matricula.size() <= 60
        && data.nivelAcesso in ['ADMINISTRADOR', 'FISCAL', 'OPERADOR'];
    }

    // Regras de validação para registros de veículos no banco de dados
    match /registros/{registroId} {
      allow read: if true;
      allow create, update: if isValidRegistro(request.resource.data) && request.resource.data.id == registroId;
      allow delete: if true;
    }

    // Regras para contas de operadores
    match /operadores/{operadorId} {
      allow read: if true;
      allow create, update: if isValidOperador(request.resource.data) && request.resource.data.id == operadorId;
      // Blindagem: Protege contra exclusão acidental ou maliciosa da conta principal de administrador
      allow delete: if operadorId != 'op-roberto-adm';
    }

    // Endpoint de teste de conectividade
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Bloqueio por padrão de qualquer outra coleção não declarada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
